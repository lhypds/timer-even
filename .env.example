# The timer website the phone embeds.
#
# Leave it unset for development: develop.sh points at the ../timer dev server
# on this machine (port 3300, rewritten to your LAN address for the phone), so
# the glasses sync with your local changes. package.sh always embeds the
# deployed site, https://timer.gcc3.com/, whatever is set here.
#
# VITE_TIMER_URL=https://timer.gcc3.com/
